{
  "name": "boost-my-pc",
  "productName": "Boost My Pc",
  "version": "2.3.0",
  "description": "Boost My Pc 2: clean, protect, and speed up your PC on Linux and Windows",
  "main": "src/main.js",
  "homepage": "https://github.com/Finoana-Randri/Boost-My-Pc",
  "repository": {
    "type": "git",
    "url": "https://github.com/Finoana-Randri/Boost-My-Pc.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage deb",
    "test:linux": "node scripts/test-linux-services.js"
  },
  "author": {
    "name": "Finoana Randri",
    "email": "Finoana-Randri@users.noreply.github.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "com.boostmypc.app",
    "productName": "Boost My Pc",
    "files": [
      "src/**/*",
      "assets/icon.png",
      "assets/tray.png",
      "assets/icon-256.png",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "artifactName": "Boost-My-Pc-Setup-${version}.${ext}",
      "icon": "build/icon.ico",
      "executableName": "Boost My Pc",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Boost My Pc",
      "uninstallDisplayName": "Boost My Pc",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "language": "1036"
    },
    "linux": {
      "artifactName": "Boost-My-Pc-${version}.${ext}",
      "icon": "assets/icon.png",
      "category": "System",
      "synopsis": "Optimisez, nettoyez et protégez votre PC",
      "executableName": "boost-my-pc",
      "maintainer": "Finoana Randri <Finoana-Randri@users.noreply.github.com>",
      "desktop": {
        "Name": "Boost My Pc",
        "Comment": "Optimisez, nettoyez et protégez votre PC",
        "Keywords": "boost;nettoyage;cleaner;system;monitor;",
        "StartupWMClass": "Boost My Pc"
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libdrm2",
        "libasound2 | libasound2t64",
        "policykit-1 | pkexec"
      ]
    },
    "copyright": "© 2026 Finoana Randri"
  }
}
